# ==============================================================================
# MULTIMODAL HARMFUL AD DETECTOR — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Server Configuration
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
SERVICE_NAME=multimodal-harmful-ad-api

# 2. Model & Inference Configuration
# Pre-trained HuggingFace CLIP model identifier (Stage 2 - Week 2)
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
# Path to trained classifier artifact (.pkl or .json bootstrap)
CLASSIFIER_MODEL_PATH=src/server/models/harmful_ad_classifier.pkl
BOOTSTRAP_WEIGHTS_PATH=src/mocks/bootstrap_classifier_weights.json
# Classification probability threshold to flag an ad as harmful (0.0 - 1.0)
HARMFUL_THRESHOLD=0.50
# Enable automatic fallback to lightweight multimodal engine when PyTorch/CLIP is not installed locally
ENABLE_LIGHTWEIGHT_FALLBACK=true

# 3. Security & CORS Configuration
CORS_ALLOWED_ORIGINS=*
MAX_IMAGE_SIZE_MB=5
REQUEST_TIMEOUT_SECONDS=10
